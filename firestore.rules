rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is an operator
    function isOperator() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOperator == true;
    }

    // Helper function to check the user doc only contains fields the app
    // actually writes, and that isOperator can only ever be created as false
    // - a client-SDK create can never self-grant operator status.
    function isValidNewUser() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'userId', 'email', 'firstName', 'lastName', 'phone', 'photoURL',
        'certLevel', 'maxDepth', 'isOperator', 'operatorNotificationThreshold',
        'createdAt', 'updatedAt'
      ]) && data.userId == userId && data.isOperator == false;
    }

    // Helper function to restrict dive site writes to the fields the app
    // actually writes, so a direct client-SDK write can't inject extra data
    // or spoof createdBy.
    function isValidSite() {
      return request.resource.data.keys().hasOnly([
        'name', 'nameLower', 'depth', 'latitude', 'longitude',
        'createdBy', 'createdAt', 'updatedAt'
      ]);
    }

    // Users collection - the app reads/writes user data exclusively through
    // the Cloud Functions API (Admin SDK, bypasses these rules). These rules
    // only govern direct client-SDK access, which the app never uses - so
    // reads are locked to the owner's own document to prevent any signed-in
    // user from harvesting every other user's email/phone/PII directly, and
    // create/update can't be used to self-grant operator status.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidNewUser();
      allow update: if isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isOperator', 'userId']);
    }

    // Availability collection - users can manage and read only their own availability
    match /availability/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Dive sites - anyone can read, operators can create/update, creators can delete
    match /diveSites/{siteId} {
      allow read: if isSignedIn();
      allow create, update: if isOperator() && isValidSite();
      allow delete: if isSignedIn() &&
                       resource.data.createdBy == request.auth.uid;
    }

    // Site interest - users can manage and read only their own interests
    match /siteInterest/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
